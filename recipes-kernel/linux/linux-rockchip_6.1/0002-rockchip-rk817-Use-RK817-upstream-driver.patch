-static irqreturn_t rk809_plug_in_isr(int irq, void *cg)
-{
-	struct rk817_battery_device *battery;
-
-	battery = (struct rk817_battery_device *)cg;
-	battery->plugin_trigger = 1;
-	battery->plugout_trigger = 0;
