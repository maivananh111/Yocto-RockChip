-	struct device *dev = battery->dev;
-	struct device_node *np = battery->dev->of_node;
-
-	pdata = devm_kzalloc(battery->dev, sizeof(*pdata), GFP_KERNEL);
-	if (!pdata)
-		return -ENOMEM;
-
-	battery->pdata = pdata;
-	/* init default param */
-	pdata->bat_res = DEFAULT_BAT_RES;
