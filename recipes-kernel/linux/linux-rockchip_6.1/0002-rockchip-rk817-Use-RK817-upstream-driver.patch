-	size = sizeof(*pdata->ocv_table) * pdata->ocv_size;
-	pdata->ocv_table = devm_kzalloc(battery->dev, size, GFP_KERNEL);
-	if (!pdata->ocv_table)
-		return -ENOMEM;
-
-	ret = of_property_read_u32_array(np, "ocv_table", pdata->ocv_table,
-					 pdata->ocv_size);
-	if (ret < 0)
-		return ret;
