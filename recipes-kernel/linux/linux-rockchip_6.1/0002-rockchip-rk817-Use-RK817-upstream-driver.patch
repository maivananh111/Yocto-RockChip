-	fcc |= rk817_bat_field_read(battery, NEW_FCC_REG0) << 0;
-
-	if (fcc < MIN_FCC) {
-		DBG("invalid fcc(%d), use design cap", fcc);
-		fcc = battery->pdata->design_capacity;
-		rk817_bat_save_fcc(battery, fcc);
