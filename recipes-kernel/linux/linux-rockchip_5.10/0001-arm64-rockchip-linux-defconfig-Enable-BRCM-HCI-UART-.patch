From 1a2cdb3c4a0c10fd5e106e67288e054c3b92586c Mon Sep 17 00:00:00 2001
From: maivananh111 <aaanh01@gmail.com>
Date: Wed, 30 Jul 2025 00:48:57 +0700
Subject: [PATCH] arm64: rockchip-linux-defconfig: Enable BRCM HCI UART
 bluetooth

Signed-off-by: maivananh111 <aaanh01@gmail.com>
---
 arch/arm64/configs/rockchip_linux_defconfig | 24 ++++++++++++---------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/configs/rockchip_linux_defconfig b/arch/arm64/configs/rockchip_linux_defconfig
index 69ab60e82f14..89e93de956ec 100644
--- a/arch/arm64/configs/rockchip_linux_defconfig
+++ b/arch/arm64/configs/rockchip_linux_defconfig
@@ -114,16 +114,20 @@ CONFIG_IP_NF_IPTABLES=y
 CONFIG_IP_NF_MANGLE=y
 CONFIG_NET_DSA=y
 CONFIG_CAN=y
-CONFIG_BT=y
-CONFIG_BT_RFCOMM=y
-CONFIG_BT_HIDP=y
-CONFIG_BT_HCIBTUSB=y
-CONFIG_BT_HCIUART=y
-CONFIG_BT_HCIUART_ATH3K=y
-CONFIG_BT_HCIBFUSB=y
-CONFIG_BT_HCIVHCI=y
-CONFIG_BT_MRVL=y
-CONFIG_BT_MRVL_SDIO=y
+CONFIG_BT=m
+CONFIG_BT_HIDP=m
+# CONFIG_BT_LE is not set
+CONFIG_BT_LEDS=y
+# CONFIG_BT_DEBUGFS is not set
+CONFIG_BT_HCIBTUSB=m
+CONFIG_BT_HCIUART=m
+CONFIG_BT_HCIUART_LL=y
+CONFIG_BT_HCIUART_BCM=y
+CONFIG_BT_HCIUART_QCA=y
+CONFIG_BT_HCIUART_MRVL=y
+CONFIG_BT_MRVL=m
+CONFIG_BT_MRVL_SDIO=m
+CONFIG_BT_QCOMSMD=m
 CONFIG_RFKILL=y
 CONFIG_RFKILL_RK=y
 CONFIG_PCI=y
-- 
2.34.1

